{
  "tasks": {
    "dev": "deno run --watch src/main.ts",
    "build": "deno compile --allow-read --allow-write --allow-run --allow-env --output yass-hat src/main.ts",
    "test:e2e": "deno task build && docker build -f Dockerfile.e2e -t yass-hat-e2e . && docker run --rm yass-hat-e2e"
  },
  "imports": {
    "@cliffy/ansi": "jsr:@cliffy/ansi@^1.0.0",
    "@cliffy/command": "jsr:@cliffy/command@^1.0.0",
    "@std/assert": "jsr:@std/assert@1",
    "@std/yaml": "jsr:@std/yaml@1"
  }
}
